# vercel
.vercel

# runtime data written by the API. Never tracked: the visitor counter changes on
# every single visit, and a git checkout during deploy would overwrite the live file.
# The API creates these on first use (store.js readJson falls back when missing).
server/data/visitors.json
server/data/enquiries.json
server/data/newsletter.json
server/data/*.tmp

# downloaded/optimised imagery IS committed (npm run images regenerates it)
# client/images/ is deliberately tracked so a fresh deploy has its photography

